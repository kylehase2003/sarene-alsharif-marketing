{"nodes": [{"id": "external_skills_instagram_skills_references_voice_rules_voice_rules", "label": "Voice Rules for Instagram", "file_type": "document", "source_file": "External-Skills/instagram-skills/references/voice-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical voice rules for the whole bundle; skill-local 'Hard rules' sections only add format-specific overrides and point back here."}, {"id": "external_skills_instagram_skills_references_voice_rules_em_dash_rule", "label": "Em Dash Density Cap (~1 per 100 words)", "file_type": "rationale", "source_file": "External-Skills/instagram-skills/references/voice-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The em dash itself is no longer a tell in 2026 (models use fewer than humans; 29% of human captions in the corpus contain one); density is the tell. Replace excess with comma, colon, parentheses, or line break, never a period. No en dashes between clauses, no double dashes."}, {"id": "external_skills_instagram_skills_references_voice_rules_vocabulary_markers", "label": "AI Vocabulary Density Markers", "file_type": "rationale", "source_file": "External-Skills/instagram-skills/references/voice-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One marker word per paragraph reads as English, two is borderline (flagged, left), three in one paragraph reads as AI and the whole paragraph gets rewritten (see ig-humanizer V3)."}, {"id": "external_skills_instagram_skills_references_voice_rules_always_forbidden_phrases", "label": "Always-Forbidden Phrases (single hit scrubbed)", "file_type": "concept", "source_file": "External-Skills/instagram-skills/references/voice-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reveal bridges, negative parallelism, dead phrases, and performed sincerity openers scrubbed on sight regardless of density (e.g. 'it's not just X, it's Y', 'game-changer', 'unpopular opinion:' on a popular take)."}, {"id": "external_skills_instagram_skills_references_voice_rules_algorithmic_note", "label": "Algorithmic Note: Sends-Per-Reach & Saves Priority", "file_type": "concept", "source_file": "External-Skills/instagram-skills/references/voice-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instagram's 2026 ranking leans on sends-per-reach and saves as the strongest spread signals, ahead of likes; the pre-publish test is whether a viewer would send this to one specific friend or save it for later."}], "edges": [{"source": "external_skills_instagram_skills_references_voice_rules_voice_rules", "target": "external_skills_instagram_skills_references_voice_rules_em_dash_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "External-Skills/instagram-skills/references/voice-rules.md", "source_location": null, "weight": 1.0}, {"source": "external_skills_instagram_skills_references_voice_rules_voice_rules", "target": "external_skills_instagram_skills_references_voice_rules_vocabulary_markers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "External-Skills/instagram-skills/references/voice-rules.md", "source_location": null, "weight": 1.0}, {"source": "external_skills_instagram_skills_references_voice_rules_voice_rules", "target": "external_skills_instagram_skills_references_voice_rules_always_forbidden_phrases", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "External-Skills/instagram-skills/references/voice-rules.md", "source_location": null, "weight": 1.0}, {"source": "external_skills_instagram_skills_references_voice_rules_voice_rules", "target": "external_skills_instagram_skills_references_voice_rules_algorithmic_note", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "External-Skills/instagram-skills/references/voice-rules.md", "source_location": null, "weight": 1.0}, {"source": "external_skills_instagram_skills_references_voice_rules_algorithmic_note", "target": "external_skills_instagram_skills_references_algorithm_heuristics_signal_weights", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "External-Skills/instagram-skills/references/voice-rules.md", "source_location": null, "weight": 1.0}], "hyperedges": []}