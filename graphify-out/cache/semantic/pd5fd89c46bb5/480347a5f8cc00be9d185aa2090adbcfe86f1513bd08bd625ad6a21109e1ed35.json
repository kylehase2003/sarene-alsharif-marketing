{"nodes": [{"id": "external_skills_instagram_skills_references_hashtag_strategy_hashtag_strategy", "label": "Instagram Hashtag Strategy 2026 (Size Not Volume)", "file_type": "document", "source_file": "External-Skills/instagram-skills/references/hashtag-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3-5 well-chosen, correctly-sized hashtags outperform 30 random ones; hashtags act as topic labels for categorization, not a discovery firehose, since reach comes mostly from sends, saves, and the recommendation engine."}, {"id": "external_skills_instagram_skills_references_hashtag_strategy_sized_tag_tiers", "label": "Niche/Mid/Broad Sized Hashtag Tiers", "file_type": "concept", "source_file": "External-Skills/instagram-skills/references/hashtag-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Niche (<50k posts): 2-3 tags, where a small account can actually rank for hours. Mid (50k-500k): 1-2 tags, the sweet spot. Broad (500k-5M+): 0-1 tag, a brief categorization touch only."}, {"id": "external_skills_instagram_skills_references_hashtag_strategy_branded_campaign_hashtags", "label": "Branded & Campaign Hashtags", "file_type": "concept", "source_file": "External-Skills/instagram-skills/references/hashtag-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "external_skills_instagram_skills_references_hashtag_strategy_hashtag_strategy", "target": "external_skills_instagram_skills_references_hashtag_strategy_sized_tag_tiers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "External-Skills/instagram-skills/references/hashtag-strategy.md", "source_location": null, "weight": 1.0}, {"source": "external_skills_instagram_skills_references_hashtag_strategy_hashtag_strategy", "target": "external_skills_instagram_skills_references_hashtag_strategy_branded_campaign_hashtags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "External-Skills/instagram-skills/references/hashtag-strategy.md", "source_location": null, "weight": 1.0}], "hyperedges": []}