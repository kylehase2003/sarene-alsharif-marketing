{"nodes": [{"id": "external_skills_instagram_skills_references_hook_formulas_overview", "label": "10 Instagram Hook Formulas - 2026 Edition", "file_type": "document", "source_file": "External-Skills/instagram-skills/references/hook-formulas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Formulas split by surface: caption-first (IG1-IG4), carousel (IG5-IG8), Reel (IG9-IG10), each mapped to a primary 2026 ranked engagement goal (saves, shares, comments, follows)."}, {"id": "external_skills_instagram_skills_references_hook_formulas_ig1_number_first_result", "label": "IG1 - Number-First Result (caption)", "file_type": "concept", "source_file": "External-Skills/instagram-skills/references/hook-formulas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal: saves. A hard, odd-precision number in the first 125 chars stops the scroll and promises a repeatable method; never invent the number, a challenged figure costs more reach than the post earned."}, {"id": "external_skills_instagram_skills_references_hook_formulas_ig2_contrarian_truth", "label": "IG2 - Contrarian Truth (caption)", "file_type": "concept", "source_file": "External-Skills/instagram-skills/references/hook-formulas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal: shares. A screenshot-ready, defensible opinion that cuts against common advice gets sent to friends and reshared to stories."}, {"id": "external_skills_instagram_skills_references_hook_formulas_ig3_relatable_cold_open", "label": "IG3 - Relatable Cold-Open (caption)", "file_type": "concept", "source_file": "External-Skills/instagram-skills/references/hook-formulas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal: comments. A specific, shared moment with no setup earns instant recognition; specificity is the whole job since it's the most-copied genre."}, {"id": "external_skills_instagram_skills_references_hook_formulas_ig4_mini_story_confession", "label": "IG4 - Mini-Story Confession (caption)", "file_type": "concept", "source_file": "External-Skills/instagram-skills/references/hook-formulas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal: comments and follows. Transparency out-pulls polish; a real failure earns comments and the payoff line earns the follow, but it has to be true."}, {"id": "external_skills_instagram_skills_references_hook_formulas_ig5_listicle_carousel", "label": "IG5 - Listicle Carousel (carousel)", "file_type": "concept", "source_file": "External-Skills/instagram-skills/references/hook-formulas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal: saves. A numbered teaching carousel is the most-saved format; the 'most people miss number k' line opens the swipe loop, and the promise is a contract the middle slides must deliver on."}, {"id": "external_skills_instagram_skills_references_hook_formulas_ig6_before_after_transformation", "label": "IG6 - Before/After Transformation (carousel)", "file_type": "concept", "source_file": "External-Skills/instagram-skills/references/hook-formulas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal: saves and follows. Proof of transformation is the most credible hook; the gap between the after (slide 1) and before (slide 2) opens the loop, vague steps kill the save."}, {"id": "external_skills_instagram_skills_references_hook_formulas_ig7_myth_buster_carousel", "label": "IG7 - Myth-Buster Carousel (carousel)", "file_type": "concept", "source_file": "External-Skills/instagram-skills/references/hook-formulas.md", "source_location": null, 